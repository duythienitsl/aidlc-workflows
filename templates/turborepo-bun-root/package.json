{
  "name": "greenfield-monorepo",
  "private": true,
  "packageManager": "bun@1.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "turbo run dev --filter=greenfield-api",
    "dev:web": "turbo run dev --filter=greenfield-web",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:cov": "turbo test:cov"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}
